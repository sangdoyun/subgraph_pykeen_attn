import pandas as pd
import rdflib
from rdflib import Graph, Literal, RDF, URIRef, Namespace, XSD
from datetime import datetime
import os

# === Config ===
DATA_FOLDER = "/mnt/data"  # Path where your CSVs are uploaded
STUDENT_ID = "u00"  # Hardcoded for now
BASE = "http://example.org/studentlife/"

ex = Namespace(BASE)

# === Initialize RDFLib Graph ===
g = Graph()
g.bind("ex", ex)

# === Helper Functions ===

def create_time_literal(ts):
    """Create xsd:dateTime Literal from timestamp."""
    if pd.isna(ts):
        return None
    try:
        ts = float(ts)
        return Literal(datetime.utcfromtimestamp(ts), datatype=XSD.dateTime)
    except:
        return None

def safe_literal(val, datatype=XSD.string):
    """Safe Literal creation."""
    if pd.isna(val):
        return None
    return Literal(val, datatype=datatype)

def student_uri():
    return ex[f"Student_{STUDENT_ID}"]

# === Processors for each modality ===

def process_wifi_location(df):
    for idx, row in df.iterrows():
        loc_id = row['location']
        start = create_time_literal(row['start'])
        end = create_time_literal(row['end'])

        if pd.isna(loc_id) or start is None or end is None:
            continue

        loc_uri = ex[f"Location_{loc_id}"]
        g.add((student_uri(), ex.visitedLocation, loc_uri))
        g.add((loc_uri, ex.startTime, start))
        g.add((loc_uri, ex.endTime, end))

def process_wifi(df):
    for idx, row in df.iterrows():
        bssid = row['bssid']
        start = create_time_literal(row['start'])
        end = create_time_literal(row['end'])

        if pd.isna(bssid) or start is None or end is None:
            continue

        wifi_uri = ex[f"WIFI_{bssid.replace(':','_')}"]
        g.add((student_uri(), ex.connectedToWIFI, wifi_uri))
        g.add((wifi_uri, ex.startTime, start))
        g.add((wifi_uri, ex.endTime, end))

def process_phonelock(df):
    for idx, row in df.iterrows():
        event = row['event']
        timestamp = create_time_literal(row['timestamp'])

        if pd.isna(event) or timestamp is None:
            continue

        g.add((student_uri(), ex.phoneLockEvent, safe_literal(event)))
        g.add((student_uri(), ex.eventTime, timestamp))

def process_phonecharge(df):
    for idx, row in df.iterrows():
        battery_state = row['battery_state']
        timestamp = create_time_literal(row['timestamp'])

        if pd.isna(battery_state) or timestamp is None:
            continue

        g.add((student_uri(), ex.phoneChargeEvent, safe_literal(battery_state)))
        g.add((student_uri(), ex.eventTime, timestamp))

def process_gps(df):
    for idx, row in df.iterrows():
        lat, lon = row['latitude'], row['longitude']
        timestamp = create_time_literal(row['timestamp'])

        if pd.isna(lat) or pd.isna(lon) or timestamp is None:
            continue

        loc_uri = ex[f"GPS_{idx}"]
        g.add((student_uri(), ex.hasGPSLocation, loc_uri))
        g.add((loc_uri, ex.latitude, Literal(lat, datatype=XSD.float)))
        g.add((loc_uri, ex.longitude, Literal(lon, datatype=XSD.float)))
        g.add((loc_uri, ex.time, timestamp))

def process_bt(df):
    for idx, row in df.iterrows():
        bt_mac = row['bt_mac']
        timestamp = create_time_literal(row['timestamp'])

        if pd.isna(bt_mac) or timestamp is None:
            continue

        bt_uri = ex[f"Bluetooth_{bt_mac.replace(':','_')}"]
        g.add((student_uri(), ex.detectedBluetoothDevice, bt_uri))
        g.add((bt_uri, ex.time, timestamp))

def process_sms(df):
    for idx, row in df.iterrows():
        type_ = row['type']
        timestamp = create_time_literal(row['timestamp'])
        number = row['number']

        if pd.isna(type_) or pd.isna(number) or timestamp is None:
            continue

        sms_uri = ex[f"SMS_{idx}"]
        g.add((student_uri(), ex.smsEvent, sms_uri))
        g.add((sms_uri, ex.smsType, safe_literal(type_)))
        g.add((sms_uri, ex.phoneNumber, safe_literal(number)))
        g.add((sms_uri, ex.time, timestamp))

def process_call_log(df):
    for idx, row in df.iterrows():
        type_ = row['type']
        timestamp = create_time_literal(row['timestamp'])
        number = row['number']

        if pd.isna(type_) or pd.isna(number) or timestamp is None:
            continue

        call_uri = ex[f"Call_{idx}"]
        g.add((student_uri(), ex.callEvent, call_uri))
        g.add((call_uri, ex.callType, safe_literal(type_)))
        g.add((call_uri, ex.phoneNumber, safe_literal(number)))
        g.add((call_uri, ex.time, timestamp))

def process_calendar(df):
    for idx, row in df.iterrows():
        title = row['title']
        start = create_time_literal(row['start_time'])
        end = create_time_literal(row['end_time'])

        if pd.isna(title) or start is None or end is None:
            continue

        event_uri = ex[f"CalendarEvent_{idx}"]
        g.add((student_uri(), ex.hasCalendarEvent, event_uri))
        g.add((event_uri, ex.eventTitle, safe_literal(title)))
        g.add((event_uri, ex.startTime, start))
        g.add((event_uri, ex.endTime, end))

def process_app_usage(df):
    for idx, row in df.iterrows():
        app = row['app_name']
        timestamp = create_time_literal(row['timestamp'])

        if pd.isna(app) or timestamp is None:
            continue

        app_uri = ex[f"App_{app.replace(' ','_')}"]
        g.add((student_uri(), ex.runningApp, app_uri))
        g.add((app_uri, ex.time, timestamp))

# === Load and Process ===

file_processors = {
    "wifi_location": process_wifi_location,
    "wifi": process_wifi,
    "phonelock": process_phonelock,
    "phonecharge": process_phonecharge,
    "gps": process_gps,
    "bt": process_bt,
    "sms": process_sms,
    "call_log": process_call_log,
    "calendar": process_calendar,
    "app_usage_running_app": process_app_usage,
}

for modality, processor in file_processors.items():
    path = os.path.join(DATA_FOLDER, f"{modality}_{STUDENT_ID}.csv")
    if os.path.exists(path):
        df = pd.read_csv(path)
        processor(df)
        print(f"Processed {modality}")
    else:
        print(f"File missing: {path}")

# === Serialize the final Graph ===

output_ttl = "/mnt/data/student_u00_graph.ttl"
g.serialize(destination=output_ttl, format="turtle")
print(f"\n✅ TKG saved to {output_ttl}")
