import pandas as pd
from rdflib import Graph, URIRef, Literal, Namespace
from rdflib.namespace import RDF, XSD
from datetime import datetime

# === Setup ===
g = Graph()

# Base namespace
EX = Namespace("http://example.org/studentlife/")
g.bind("ex", EX)

# Student URI
student = EX["student_u00"]

# Function to safely parse timestamps
def parse_timestamp(ts):
    try:
        # assume timestamp is in seconds
        return datetime.utcfromtimestamp(float(ts))
    except Exception:
        return None

# === File paths ===
file_paths = {
    "wifi_location": "/mnt/data/wifi_location_u00.csv",
    "wifi": "/mnt/data/wifi_u00.csv",
    "phonelock": "/mnt/data/phonelock_u00.csv",
    "phonecharge": "/mnt/data/phonecharge_u00.csv",
    "gps": "/mnt/data/gps_u00.csv",
    "bt": "/mnt/data/bt_u00.csv",
    "sms": "/mnt/data/sms_u00.csv",
    "call_log": "/mnt/data/call_log_u00.csv",
    "calendar": "/mnt/data/calendar_u00.csv",
    "app_usage": "/mnt/data/app_usage_running_app_u00.csv",
}

# === Process each file ===

# --- 1. WiFi Location ---
df = pd.read_csv(file_paths["wifi_location"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("timestamp"))
    if pd.isna(row.get("bssid")) or ts is None:
        continue
    wifi_loc = EX[f"wifi_loc_{row['bssid']}"]
    g.add((student, EX.connectedToLocation, wifi_loc))
    g.add((wifi_loc, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 2. WiFi ---
df = pd.read_csv(file_paths["wifi"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("start"))
    if pd.isna(row.get("bssid")) or ts is None:
        continue
    wifi_dev = EX[f"wifi_{row['bssid']}"]
    g.add((student, EX.connectedToDevice, wifi_dev))
    g.add((wifi_dev, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 3. Phone Lock ---
df = pd.read_csv(file_paths["phonelock"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("timestamp"))
    if pd.isna(row.get("event")) or ts is None:
        continue
    lock_event = EX[f"lockevent_{idx}"]
    g.add((student, EX.phoneLockState, Literal(row['event'])))
    g.add((lock_event, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 4. Phone Charge ---
df = pd.read_csv(file_paths["phonecharge"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("timestamp"))
    if pd.isna(row.get("status")) or ts is None:
        continue
    charge_event = EX[f"chargeevent_{idx}"]
    g.add((student, EX.phoneChargingStatus, Literal(row['status'])))
    g.add((charge_event, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 5. GPS ---
df = pd.read_csv(file_paths["gps"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("timestamp"))
    if pd.isna(row.get("lat")) or pd.isna(row.get("lon")) or ts is None:
        continue
    loc = EX[f"gpsloc_{idx}"]
    g.add((student, EX.hasGPSLocation, loc))
    g.add((loc, EX.latitude, Literal(row['lat'], datatype=XSD.float)))
    g.add((loc, EX.longitude, Literal(row['lon'], datatype=XSD.float)))
    g.add((loc, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 6. Bluetooth ---
df = pd.read_csv(file_paths["bt"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("timestamp"))
    if pd.isna(row.get("bt_mac")) or ts is None:
        continue
    bt_dev = EX[f"bt_{row['bt_mac']}"]
    g.add((student, EX.connectedToBluetooth, bt_dev))
    g.add((bt_dev, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 7. SMS ---
df = pd.read_csv(file_paths["sms"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("timestamp"))
    if pd.isna(row.get("message")) or ts is None:
        continue
    sms = EX[f"sms_{idx}"]
    g.add((student, EX.sentSMS, sms))
    g.add((sms, EX.messageBody, Literal(row['message'])))
    g.add((sms, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 8. Call Log ---
df = pd.read_csv(file_paths["call_log"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("startTimestamp"))
    if pd.isna(row.get("otherParty")) or ts is None:
        continue
    call = EX[f"call_{idx}"]
    g.add((student, EX.madeCallTo, Literal(row['otherParty'])))
    g.add((call, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 9. Calendar ---
df = pd.read_csv(file_paths["calendar"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("start"))
    if pd.isna(row.get("title")) or ts is None:
        continue
    event = EX[f"calendar_{idx}"]
    g.add((student, EX.hasCalendarEvent, event))
    g.add((event, EX.eventTitle, Literal(row['title'])))
    g.add((event, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# --- 10. App Usage ---
df = pd.read_csv(file_paths["app_usage"])
for idx, row in df.iterrows():
    ts = parse_timestamp(row.get("timestamp"))
    if pd.isna(row.get("app_name")) or ts is None:
        continue
    app = EX[f"app_{row['app_name'].replace(' ', '_')}"]
    g.add((student, EX.usedApp, app))
    g.add((app, EX.atTime, Literal(ts.isoformat(), datatype=XSD.dateTime)))

# === Save the Graph ===
g.serialize(destination="/mnt/data/studentlife_u00.ttl", format="turtle")
print("✅ Turtle file created at /mnt/data/studentlife_u00.ttl")
